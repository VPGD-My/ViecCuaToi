# Sao chép file này thành .env.local rồi điền giá trị thật.
# Lấy ở Supabase Dashboard > Project Settings > API.
# Chỉ dùng anon public key. TUYỆT ĐỐI không đưa service_role key vào đây hay vào GitHub.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Nhắc việc (Web Push). Khoá công khai VAPID, tạo bằng: npx web-push generate-vapid-keys
# Khoá bí mật VAPID chỉ đặt trong Supabase secrets, không đặt ở đây.
VITE_VAPID_PUBLIC_KEY=BEl62iUYgU...
# Chỉ dùng để hiện câu giải thích trong app. Giờ nhắc thật do Edge Function quyết định.
VITE_REMIND_BEFORE_MIN=15
VITE_MORNING_TIME=07:30
